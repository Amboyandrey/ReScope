ENVIRONMENT=development
DEBUG=true

# Owner role — the only URL Alembic uses. Compose exposes Postgres on host port 5433 so it can run
# next to another local stack on 5432.
DATABASE_URL=postgresql+asyncpg://rescope:rescope@localhost:5433/rescope

# Optional. The low-privilege role the API and workers serve requests as, so row-level security
# actually applies (the owner role above is exempt by Postgres default). Compose sets it; local
# non-Docker dev can leave it unset.
APP_DATABASE_URL=

REDIS_URL=redis://localhost:16380/0

# The root domain the web app is served from. Tenants are subdomains of it, and the session
# cookie is scoped to `.` + this value so one login works across a user's tenants.
ROOT_DOMAIN=rescope.localhost
CORS_ORIGINS=["http://rescope.localhost:3000"]

# Anthropic key that drives profiling for every tenant (platform-paid). Never stored in the DB.
ANTHROPIC_API_KEY=

# The self-hosted embeddings service (see infra/docker-compose.yml's `embeddings` service).
# Compose points this at the container; local non-Docker dev needs it running separately
# (docker compose -f infra/docker-compose.yml up embeddings) and pointed at its host port.
EMBEDDINGS_URL=http://localhost:18080
