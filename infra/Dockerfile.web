# Build context: apps/web (see infra/docker-compose.yml).

FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_ROOT_DOMAIN=rescope.localhost
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_ROOT_DOMAIN=$NEXT_PUBLIC_ROOT_DOMAIN
RUN pnpm build

FROM node:22-alpine AS runtime
RUN addgroup -S rescope && adduser -S -G rescope rescope
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000

COPY --from=builder --chown=rescope:rescope /app/.next/standalone ./
COPY --from=builder --chown=rescope:rescope /app/.next/static ./.next/static
COPY --from=builder --chown=rescope:rescope /app/public ./public

USER rescope
EXPOSE 3000
CMD ["node", "server.js"]
