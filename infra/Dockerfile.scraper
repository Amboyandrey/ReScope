# Build context: apps/api (see infra/docker-compose.yml). Separate image from Dockerfile.api:
# Chromium and its system libraries are heavy and this is the only process that ever needs them —
# a crash in here (a hung render, an OOM'd browser) never takes the API or its own worker with it.

FROM python:3.12-slim AS builder
RUN pip install --no-cache-dir uv
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app

FROM python:3.12-slim AS runtime
WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/app /app/app
ENV PATH="/app/.venv/bin:$PATH"

# playwright install-deps needs apt as root; the browser itself is installed after, into this
# image layer rather than a volume, so a fresh container never launches without it. Runs as root
# throughout — Chromium's own sandbox is what's disabled at launch (--no-sandbox, see
# app/scraping/render.py), not a substitute for it, so there's no isolation benefit left to gain
# by additionally dropping to a non-root user here.
RUN playwright install --with-deps chromium

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s \
    CMD python -c "import redis; redis.from_url('${REDIS_URL:-redis://redis:6379/0}').ping()" || exit 1

CMD ["arq", "app.workers.scraper.WorkerSettings"]
