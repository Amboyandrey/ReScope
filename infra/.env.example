# Copy to `.env` next to this file and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#   docker compose -f docker-compose.prod.yml exec api /app/.venv/bin/alembic upgrade head
# (the api image already runs migrations on boot — that second command is only for re-running
# them by hand, e.g. right after the very first deploy, before waiting on a container restart.)

# The domain this deploy serves. Point both `DOMAIN` and `*.DOMAIN` A/AAAA records at this host.
DOMAIN=rescope.example.com

# Caddy's ACME account email — Let's Encrypt sends expiry/revocation notices here.
ACME_EMAIL=you@example.com

# DNS-01 challenge credential for the wildcard cert (see Caddyfile and Dockerfile.caddy — this
# assumes Cloudflare; swap both files together if you're on a different DNS provider). Needs
# Zone:DNS:Edit permission on the zone that hosts DOMAIN.
CLOUDFLARE_API_TOKEN=

# Postgres's own password (not the app's restricted role below).
POSTGRES_PASSWORD=

# The low-privilege `rescope_app` role's password — the RLS-restricted role the API and workers
# actually authenticate as. Only takes effect on the very first `alembic upgrade head` against a
# fresh database, since the role is created with `IF NOT EXISTS`; rotating it later needs a manual
# `ALTER ROLE rescope_app PASSWORD '...'` run against Postgres to match whatever you put here.
RESCOPE_APP_ROLE_PASSWORD=

# Platform-paid key for the scraping pipeline's own LLM calls (see docs/PLAN.md §1 — a workspace
# can register its own instead, see §12). Leave blank and the app still runs; scrapes will just
# fail at extraction for any workspace that hasn't registered its own key.
ANTHROPIC_API_KEY=

# Platform-paid Browser Use Cloud key (docs/PLAN.md §13) — same split as the Anthropic key above.
BROWSER_USE_API_KEY=

# Wraps every workspace-registered credential's own data key (app/core/crypto.py) — a base64
# 256-bit value, e.g. `python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"`.
# Required: without it, saving a workspace API key fails loudly rather than storing it insecurely.
# Rotating this later means rewrapping every stored data key, not just changing the env var.
MASTER_KEY=
